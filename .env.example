# Canonical list of environment variables for the Vertex web app.
# Copy to .env.local and fill in. Never commit real values.
#
# NEXT_PUBLIC_* values reach the browser. Everything else is server-only.
# The Studio workspace has its own env file: studio/.env.example

# --- Sanity ---------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Optional. Defaults to the date pinned in sanity/env.ts.
NEXT_PUBLIC_SANITY_API_VERSION=
# Server-only. Viewer token — the dataset is private, so every read is authenticated.
SANITY_API_READ_TOKEN=

# --- Search (Sanity Context MCP + LLM) ------------------------------------
# Server-only. The Context document's slug is the last path segment; the MCP only serves a dataset
# that has a deployed Studio application. See studio/scripts/context/README.md.
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-03-03/context/mcp/<projectId>/<dataset>/vertex-search
# Server-only. The search route is the only thing that calls the LLM.
OPENAI_API_KEY=
# Optional. Overrides the model the search route uses.
OPENAI_SEARCH_MODEL=

# --- Clerk ----------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- PostHog --------------------------------------------------------------
# The project token is public by design and reaches the browser.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
